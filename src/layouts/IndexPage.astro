---
import ForumShell from './ForumShell.astro';
import Comment from '@/components/Comment.astro';
import Donate from '@/components/Donate.astro';
import {comment,donate} from '@/consts';
const {title,frontmatter={}}=Astro.props;
---
<ForumShell title={title}><slot/>{donate.enable&&frontmatter.donate&&<Donate/>}{comment.enable&&frontmatter.comment&&<Comment/>}</ForumShell>